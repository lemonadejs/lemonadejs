{
    "name": "cropper",
    "props": {
        "src": {
            "type": "string",
            "default": ""
        },
        "width": {
            "type": "number",
            "default": 800
        },
        "height": {
            "type": "number",
            "default": 360
        },
        "cropwidth": {
            "type": "number",
            "default": 300
        },
        "cropheight": {
            "type": "number",
            "default": 240
        },
        "resizable": {
            "type": "boolean",
            "default": false
        },
        "controls": {
            "type": "boolean",
            "default": true
        },
        "original": {
            "type": "boolean",
            "default": false
        },
        "aspect": {
            "type": "number",
            "default": 0
        },
        "format": {
            "type": "string",
            "default": "png"
        },
        "quality": {
            "type": "number",
            "default": 0.92
        },
        "outputwidth": {
            "type": "number",
            "default": 0
        },
        "outputheight": {
            "type": "number",
            "default": 0
        }
    },
    "bind": {
        "type": "object"
    },
    "events": [
        "onchange",
        "onload"
    ],
    "api": [
        "getValue",
        "setValue",
        "getImage",
        "zoom",
        "rotate",
        "brightness",
        "contrast",
        "saturate",
        "grayscale",
        "sepia",
        "hue",
        "blur",
        "invert",
        "rotateLeft",
        "rotateRight",
        "flipHorizontal",
        "flipVertical",
        "setAspect",
        "save",
        "reset",
        "upload"
    ]
}
