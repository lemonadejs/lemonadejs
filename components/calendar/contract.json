{
    "name": "calendar",
    "props": {
        "name": {
            "type": "string",
            "default": ""
        },
        "range": {
            "type": "boolean",
            "default": false
        },
        "time": {
            "type": "boolean",
            "default": false
        },
        "numeric": {
            "type": "boolean",
            "default": false
        },
        "format": {
            "type": "string",
            "default": ""
        },
        "type": {
            "type": "string",
            "default": ""
        },
        "data": {
            "type": "array"
        },
        "min": {
            "type": "string",
            "default": ""
