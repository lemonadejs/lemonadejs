{
    "name": "@lemonadejs/kanban",
    "version": "6.0.0-beta.0",
    "description": "LemonadeJS kanban block — drag-and-drop board whose card DOM identity survives cross-column moves (one flat keyed list, CSS grid placement); contract-verified, framework-agnostic.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/lemonadejs/lemonadejs.git",
        "directory": "components/kanban"
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./style.css": "./dist/style.css",
        "./contract.json": "./contract.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "contract.json",
        "verify.json"
    ],
    "peerDependencies": {
        "lemonadejs": "^6.0.0-beta.0"
    }
}
