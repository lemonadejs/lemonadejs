{
    "name": "lemonadejs",
    "title": "Agnostic micro reactive JavaScript library with two-way data binding.",
    "description": "Lemonade is a lightweight, micro reactive agnostic JavaScript library to create quick and reusable reactive JS components, with no dependencies.",
    "author": {
        "name": "Contact <contact@jspreadsheet.com>",
        "url": "https://lemonadejs.com"
    },
    "keywords": [
        "reactive",
        "two-way binding",
        "two-way data binding",
        "javascript two-way data binding",
        "reactive micro library",
        "reactive javascript library",
        "hooks",
        "javascript",
        "micro library",
        "js",
        "library"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/lemonadejs/lemonadejs.git"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "node build.js",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "esbuild": "^0.24.0",
        "jsdom": "^22.0.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    },
    "main": "dist/lemonade.js",
    "types": "dist/index.d.ts",
    "unpkg": "dist/lemonade.min.js",
    "jsdelivr": "dist/lemonade.min.js",
    "files": [
        "dist",
        "llms.txt"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/lemonade.mjs",
            "default": "./dist/lemonade.js"
        },
        "./test": {
            "types": "./dist/test.d.ts",
            "import": "./dist/test.mjs",
            "default": "./dist/test.js"
        },
        "./forms": {
            "types": "./dist/forms.d.ts",
            "import": "./dist/forms.mjs",
            "default": "./dist/forms.js"
        },
        "./llms.txt": "./llms.txt"
    },
    "version": "6.0.0-beta.0"
}
