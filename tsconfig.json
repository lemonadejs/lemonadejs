{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": false,
        "noImplicitOverride": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "lemonadejs": ["src/index.ts"],
            "lemonadejs/test": ["src/test.ts"],
            "lemonadejs/react": ["src/react.ts"],
            "@lemonadejs/*": ["components/*/src/index.ts"]
        }
    },
    "include": ["src", "components/**/*.ts", "tests", ".probe"],
    "exclude": ["components/*/dist", "node_modules"]
}
